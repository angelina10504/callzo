# Copy to .env and fill POSTGRES_PASSWORD and WEBHOOK_SECRET before running Docker Compose.
# Never commit the populated .env. USAGE_API_KEY is reserved for a later step.
# Use the shared webhook secret supplied in Task1_spec.md.
WEBHOOK_SECRET=
USAGE_API_KEY=
POSTGRES_USER=callzo
POSTGRES_DB=callzo
POSTGRES_PASSWORD=
# Provisional demo value; verify that cap_burst crosses it partway through.
MONTHLY_CAP_CENTS=1000
